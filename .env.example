# Base URL of the stir_webserver API
VITE_API_BASE_URL=http://localhost:8000

# Base URL of the auth microservice
VITE_AUTH_BASE_URL=http://localhost:3001

# Enable VPN/proxy filtering via ip-api.com (true/false)
VITE_ENABLE_VPN_FILTERING=true

# ip-api.com pro API key (for paid tier, https://pro.ip-api.com/)
VITE_IP_API_KEY=
